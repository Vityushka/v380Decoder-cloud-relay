# Copy this file to .env and fill in the camera credentials.
V380_ID=12345678
V380_USERNAME=admin
V380_PASSWORD=change-me

# Optional cloud relay override. Normally leave this empty.
V380_RELAY_IP=

# Keep 127.0.0.1 for local-only access.
# Set 0.0.0.0 only when access is protected by a firewall, VPN, or reverse proxy.
BIND_ADDRESS=127.0.0.1
